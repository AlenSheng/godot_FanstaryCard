# Release packages and private compiler outputs are never source inputs.
/builds/
/artifacts/release-protection/
/server/artifacts/release-protection/
*.pdb
*.key
*.dpapi
__pycache__/
/server/.artifacts/
/server/.env
/server/cloud-env.local.bat
/server/local-backups/*.dump
/server/local-backups/*.dump.sha256

# Local protocol migration toolchains, test workspaces and generated build output.
/work/
/server/.packages/
/server/artifacts/protobuf-*/
/protocol/tests/bin/
/protocol/tests/obj/
