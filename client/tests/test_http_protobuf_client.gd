extends SceneTree
const Proto = preload("res://network/protobuf.gd")
const Http = preload("res://network/http_protocol.gd")
const Gateway = preload("res://network/gateway.gd")
var failures := []
var checks := 0
func check(condition: bool, label: String) -> void:
	checks += 1
	if not condition: failures.append(label)
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var proto := Proto.new(true)
	var vectors: Array = JSON.parse_string(FileAccess.get_file_as_string("res://data/golden-vectors.json"))
	for vector in vectors:
		var codec := Proto.new(Http.SCHEMA.data.messages.has(vector.message))
		var decoded := codec.decode(vector.message, str(vector.hex).hex_decode())
		check(codec.error.is_empty(), "official vector " + vector.name)
		if vector.name == "profile-int64": check(decoded.version == 9223372036854775807, "max int64")
		if vector.name == "profile-update-min-int64": check(decoded.expected_version == -9223372036854775807 - 1 and decoded.display_name == "", "min int64 / present empty")
		var encoded := codec.encode(vector.message, decoded)
		check(codec.error.is_empty(), "encode vector " + vector.name)
		check(codec.decode(vector.message, encoded) == decoded, "semantic roundtrip " + vector.name)
	var packed := proto.decode("CreatePreparationRequest", "28012a0202032804".hex_decode())
	check(proto.error.is_empty() and packed.safe_slot_indexes == [1,2,3,4], "mixed packed order")
	var negative := proto.decode("CreatePreparationRequest", "28ffffffffffffffffff01".hex_decode())
	check(negative.safe_slot_indexes == [-1], "negative int32")
	var merged := proto.decode("BootstrapResponse", "1a030a01611a03120162".hex_decode())
	check(proto.error.is_empty() and merged.player.user_id == "a" and merged.player.display_name == "b", "singular message merge")
	var optional := proto.decode("PurchaseShopRequest", "1000".hex_decode())
	check(optional.quantity == 0 and not proto.decode("PurchaseShopRequest", PackedByteArray()).has("quantity"), "optional zero versus absent")
	for hex in ["00", "0a8001", "088080808080808080808002", "2a0180", "0d0000", "0b", "ffffffffffffffffff01"]:
		proto.decode("CreatePreparationRequest", hex.hex_decode())
		check(not proto.error.is_empty(), "malformed " + hex)
	var absent := Http.from_wire("BootstrapResponse", proto.decode("BootstrapResponse", PackedByteArray()))
	check(absent.unfinishedMatch == null and absent.unfinishedSettlement == null and absent.activePreparation == null, "nullable messages")
	var profile := Http.from_wire("PlayerProfileResponse", proto.decode("PlayerProfileResponse", PackedByteArray()))
	check(profile.selectedClass == null, "nullable optional scalar")
	var sparse := Http.from_wire("ShopProductPayload", {"amount":3})
	check(not sparse.has("cardId") and sparse.amount == 3 and sparse.get("count",1) == 1, "sparse typed shop payload defaults")
	var slots := Http.from_wire("LoadoutResponse", {"equipment_ids": ["", "id", "", "", ""]})
	check(slots.equipmentIds == [null,"id",null,null,null], "nullable equipment slots")
	var effects := Http.from_wire("CardEffectResponse", {"draw_charge":"1.25"})
	check(effects.drawCharge == 1.25, "effect decimal")
	check(Http.from_wire("WalletResponse", {"gold":9223372036854775807}).gold == 9223372036854775807, "money stays int64")
	for entry in Http.REGISTRY.data.endpoints:
		var path: String = entry.path
		var regex := RegEx.new()
		regex.compile("\\{[^}]+\\}")
		path = regex.sub(path, "11111111-2222-3333-4444-555555555555", true)
		var method: int = Http.METHODS.find_key(entry.method)
		check(Http.route(path + "/?offset=0", method).get("response") == entry.response, "route " + entry.method + " " + entry.path)
	check(Http.route("/api/v1/mail/not-a-guid", HTTPClient.METHOD_DELETE).is_empty(), "GUID constraint")
	check(Http.route("/api/v1/bootstrap/extra", HTTPClient.METHOD_GET).is_empty(), "no prefix match")
	check(Http.route("/api/v1/bootstrap", HTTPClient.METHOD_POST).is_empty(), "method match")
	check(Http.is_perimeter("/api/v1/client-info", HTTPClient.METHOD_GET), "perimeter whitelist")
	check(not Http.is_perimeter("/api/v1/unknown", HTTPClient.METHOD_GET), "unknown denied")
	var large := "x".repeat(20000)
	var data := proto.encode("HttpError", {"detail":large})
	check(proto.error.is_empty() and proto.decode("HttpError", data).detail == large, "HTTP >16KiB allowed")
	var realtime := Proto.new()
	realtime.decode("ServerEnvelope", data)
	check(not realtime.error.is_empty(), "realtime 16KiB retained")
	proto.encode("HttpError", {"detail":"x".repeat(131073)})
	check(not proto.error.is_empty(), "string limit")
	var too_many := []
	too_many.resize(4097)
	too_many.fill(1)
	proto.encode("CreatePreparationRequest", {"safe_slot_indexes":too_many})
	check(not proto.error.is_empty(), "collection limit")
	var excess_wire := PackedByteArray()
	for index in range(4097): excess_wire.append_array(PackedByteArray([40, 0]))
	proto.decode("CreatePreparationRequest", excess_wire)
	check(not proto.error.is_empty(), "decode collection limit")
	var excess_body := PackedByteArray()
	excess_body.resize(2097153)
	proto.decode("Empty", excess_body)
	check(not proto.error.is_empty(), "HTTP body limit")
	check(not Http.decode_response(Http.route("/api/v1/bootstrap", 0), 200, PackedStringArray(["Content-Type: text/html"]), "error".to_utf8_buffer()).ok, "proxy format rejected")
	check(Http.decode_response({"response":"Empty"}, 204, PackedStringArray(), PackedByteArray()).ok, "204 empty")
	var old = preload("res://tests/test_protobuf.gd").new().run_test()
	check(old.ok, "existing realtime regression: " + str(old.message))
	print(JSON.stringify({"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
