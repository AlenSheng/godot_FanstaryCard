+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        with:
+          persist-credentials: false
+      - name: Install verified tools; exercise cached restart and private database
+        run: |
+          set -euo pipefail
+          bash tools/cloud/setup.sh
+          python3 tools/cloud/install_tools.py
+          timeout 90 bash tools/cloud/start.sh
+          bash tools/cloud/stop.sh
+          timeout 90 bash tools/cloud/start.sh
+      - name: Real scratch-image activation and PostgreSQL backup/rollback drill
+        run: python3 tools/cloud/local_integration.py --output /tmp/fc-cloud-tools/evidence/local-integration.json
+      - name: Isolated Godot codecs and loopback transport
+        run: |
+          set -euo pipefail
+          source tools/cloud/env.sh
+          python3 client/tests/run_http_protobuf_client.py --godot "$FANTASYCARD_CLOUD_TOOLS/godot/godot" --work-dir "$FANTASYCARD_CLOUD_TOOLS/evidence/http-fixture"
+      - name: Stop private test database
+        if: always()
+        run: bash tools/cloud/stop.sh
+      - uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f # v7.0.0
+        if: always()
+        with:
+          name: cloud-local-${{ github.run_id }}-${{ github.run_attempt }}
+          path: /tmp/fc-cloud-tools/evidence
+          retention-days: 14
+          if-no-files-found: warn
+  final-runtime-image:
+    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
+    runs-on: ubuntu-24.04
+    timeout-minutes: 70
+    env:
