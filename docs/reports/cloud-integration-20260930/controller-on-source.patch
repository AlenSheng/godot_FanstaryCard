@@ -0,0 +1,213 @@
+name: Owner-confirmed silicon valley test deployment
+
+on:
+  workflow_dispatch:
+    inputs:
+      pr_number:
+        description: Same-repository open PR targeting release (freeze before dispatch)
+        required: true
+        type: string
+      confirm_source_sha:
+        description: Owner confirms deployment of this exact full SHA (repeat commit_sha)
+        required: true
+        type: string
+      rollback_baseline_sha:
+        description: Full running baseline SHA reviewed for application rollback compatibility
+        required: true
+        type: string
+      confirm_rollback_compatibility:
+        description: Data and snapshot contracts were reviewed as compatible with this rollback baseline
+        required: true
+        default: false
+        type: boolean
+      confirm_restart:
+        description: I authorize this test deployment and necessary application restart
+        required: true
+        default: false
+        type: boolean
+      commit_sha:
+        description: Reviewed full 40-character lowercase PR head SHA
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: silicon-valley-test-deploy
+  cancel-in-progress: false
+
+jobs:
+  validate:
+    if: github.repository == 'AlenSheng/godot_FanstaryCard' && github.ref == 'refs/heads/release'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    permissions:
+      contents: read
+      pull-requests: read
+      actions: read
+    outputs:
+      source_sha: ${{ steps.source.outputs.source_sha }}
+      pr_number: ${{ steps.source.outputs.pr_number }}
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - name: Validate release controller, exact owner confirmation and live branch policy
+        id: source
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PR_NUMBER: ${{ inputs.pr_number }}
+          COMMIT_SHA: ${{ inputs.commit_sha }}
+          ROLLBACK_BASELINE_SHA: ${{ inputs.rollback_baseline_sha }}
+          CONFIRM_ROLLBACK_COMPATIBILITY: ${{ inputs.confirm_rollback_compatibility }}
+          CONFIRM_SOURCE_SHA: ${{ inputs.confirm_source_sha }}
+          CONFIRM_RESTART: ${{ inputs.confirm_restart }}
+          TEST_DEPLOY_APPROVAL_MODE: ${{ vars.TEST_DEPLOY_APPROVAL_MODE }}
+          TEST_DEPLOY_ENABLED: ${{ vars.TEST_DEPLOY_ENABLED }}
+          TEST_DEPLOY_APPROVED_WORKFLOW_SHA: ${{ vars.TEST_DEPLOY_APPROVED_WORKFLOW_SHA }}
+        run: python3 tools/cloud/deployment.py preflight --output evidence/preflight.json
+      - uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f # v7.0.0
+        with:
+          name: deploy-preflight-${{ github.run_id }}-${{ github.run_attempt }}
+          path: evidence/preflight.json
+          retention-days: 14
+
+  build:
+    needs: validate
+    runs-on: ubuntu-24.04
+    timeout-minutes: 70
+    services:
+      postgres:
+        image: postgres:18
+        env:
+          POSTGRES_DB: fantasycard_test
+          POSTGRES_USER: postgres
+          POSTGRES_PASSWORD: postgres
+        ports: ['5432:5432']
+        options: >-
+          --health-cmd "pg_isready -U postgres -d fantasycard_test"
+          --health-interval 5s --health-timeout 5s --health-retries 12
+    outputs:
+      artifact_id: ${{ steps.image.outputs.artifact-id }}
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        with:
+          ref: ${{ github.sha }}
+          path: trusted
+          persist-credentials: false
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        with:
+          ref: ${{ needs.validate.outputs.source_sha }}
+          path: source
+          persist-credentials: false
+      - uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7.0.0
+        with:
+          name: deploy-preflight-${{ github.run_id }}-${{ github.run_attempt }}
+          path: evidence
+      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68 # v6.0.0
+        with:
+          global-json-file: source/server/global.json
+      - name: Test exact source with the existing Domain and PostgreSQL regressions
+        working-directory: source
+        env:
+          EXPECTED_SHA: ${{ needs.validate.outputs.source_sha }}
+          FANTASYCARD_TEST_POSTGRES: Host=127.0.0.1;Port=5432;Username=postgres;Password=postgres;Database=fantasycard_test
+        run: |
+          set -euo pipefail
+          test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
+          mkdir -p ../evidence/tests
+          dotnet --info > ../evidence/tests/dotnet.txt
+          dotnet test server/tests/FantasyCard.Domain.Tests/FantasyCard.Domain.Tests.csproj -c Release --logger 'trx;LogFileName=domain.trx' --results-directory "$GITHUB_WORKSPACE/evidence/tests"
+          dotnet test server/tests/FantasyCard.Server.Tests/FantasyCard.Server.Tests.csproj -c Release --logger 'trx;LogFileName=postgres.trx' --results-directory "$GITHUB_WORKSPACE/evidence/tests"
+      - name: Require executed PostgreSQL results with no failed or skipped cases
+        run: python3 trusted/tools/cloud/deployment.py tests --directory evidence/tests
+      - name: Build the existing Dockerfile and archive the immutable tested image
+        env:
+          SOURCE_SHA: ${{ needs.validate.outputs.source_sha }}
+        run: |
+          set -euo pipefail
+          mkdir -p image-artifact
+          python3 trusted/tools/cloud/deployment.py health --updater trusted/server/deploy/fantasycard-update.sh --output image-artifact/health.sh
+          docker build --label "org.opencontainers.image.revision=$SOURCE_SHA" --file source/server/src/FantasyCard.Server/Dockerfile --tag "fantasycard-test:$SOURCE_SHA" source 2>&1 | tee evidence/build.log
+          git -C source diff --exit-code -- . ':!**/obj/**' ':!**/bin/**'
+          docker build --target build --file source/server/src/FantasyCard.Server/Dockerfile --tag "fantasycard-test-builder:$SOURCE_SHA" source > evidence/builder.log 2>&1
+          python3 trusted/tools/cloud/validate_image.py --source source --image "fantasycard-test:$SOURCE_SHA" --builder "fantasycard-test-builder:$SOURCE_SHA" --source-sha "$SOURCE_SHA" --output image-artifact/image-validation.json --diagnostics evidence/image-diagnostics > evidence/image-validation.log 2>&1
+          docker save "fantasycard-test:$SOURCE_SHA" | gzip -1 > image-artifact/image.tar.gz
+          python3 trusted/tools/cloud/deployment.py manifest --preflight evidence/preflight.json --archive image-artifact/image.tar.gz --image-tag "fantasycard-test:$SOURCE_SHA" --output image-artifact/manifest.json
+      - uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f # v7.0.0
+        id: image
+        with:
+          name: tested-image-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            image-artifact/image.tar.gz
+            image-artifact/manifest.json
+            image-artifact/image-validation.json
+          retention-days: 7
+          if-no-files-found: error
+      - uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f # v7.0.0
+        if: always()
+        with:
+          name: deploy-build-tests-${{ github.run_id }}-${{ github.run_attempt }}
+          path: evidence
+          retention-days: 14
+
+  deploy:
+    needs: [validate, build]
+    if: github.repository == 'AlenSheng/godot_FanstaryCard' && github.ref == 'refs/heads/release'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 50
+    environment:
+      name: silicon-valley-test
+      url: https://www.relicbound.cn/health/ready
+    permissions:
+      contents: read
+      pull-requests: read
+      actions: read
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        with:
+          ref: ${{ github.sha }}
+          path: trusted
+          persist-credentials: false
+      - name: Revalidate source and protections before secret access
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PR_NUMBER: ${{ needs.validate.outputs.pr_number }}
+          COMMIT_SHA: ${{ needs.validate.outputs.source_sha }}
+          ROLLBACK_BASELINE_SHA: ${{ inputs.rollback_baseline_sha }}
+          CONFIRM_ROLLBACK_COMPATIBILITY: ${{ inputs.confirm_rollback_compatibility }}
+          CONFIRM_SOURCE_SHA: ${{ inputs.confirm_source_sha }}
+          CONFIRM_RESTART: ${{ inputs.confirm_restart }}
+          TEST_DEPLOY_APPROVAL_MODE: ${{ vars.TEST_DEPLOY_APPROVAL_MODE }}
+          TEST_DEPLOY_ENABLED: ${{ vars.TEST_DEPLOY_ENABLED }}
+          TEST_DEPLOY_APPROVED_WORKFLOW_SHA: ${{ vars.TEST_DEPLOY_APPROVED_WORKFLOW_SHA }}
+        run: python3 trusted/tools/cloud/deployment.py preflight --output deploy-evidence/preflight.json
+      - name: Verify artifact API identity from this run and attempt
+        env:
+          GH_TOKEN: ${{ github.token }}
+          ARTIFACT_ID: ${{ needs.build.outputs.artifact_id }}
+        run: python3 trusted/tools/cloud/deployment.py artifact --id "$ARTIFACT_ID"
+      - uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7.0.0
+        with:
+          artifact-ids: ${{ needs.build.outputs.artifact_id }}
+          path: image-artifact
+          merge-multiple: true
+      - name: Transfer, deploy and verify tested image using strict SSH host verification
+        env:
+          COMMIT_SHA: ${{ needs.validate.outputs.source_sha }}
+          TEST_SERVER_SSH_KEY: ${{ secrets.TEST_SERVER_SSH_KEY }}
+          TEST_SERVER_KNOWN_HOSTS: ${{ secrets.TEST_SERVER_KNOWN_HOSTS }}
+        run: python3 trusted/tools/cloud/ship.py
+      - name: Write acceptance evidence location
+        if: always()
+        run: |
+          printf 'Controlled test deployment evidence: deploy-acceptance-%s-%s\n\nPR13 full acceptance remains governed by its independent register.\n' "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" >> "$GITHUB_STEP_SUMMARY"
+      - uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f # v7.0.0
+        if: always()
+        with:
+          name: deploy-acceptance-${{ github.run_id }}-${{ github.run_attempt }}
+          path: deploy-evidence
+          retention-days: 30
+          if-no-files-found: warn
