+  push:
+    branches: ['codex/cloud-test-deployment-20260930']
+    paths: ['tools/cloud/**', '.github/workflows/cloud-config-check.yml', '.github/workflows/test-server-deploy.yml']
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: cloud-config-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+jobs:
+  static-and-mock:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        with:
+          persist-credentials: false
+      - name: Compile and exercise authorization, transactions and failure handling
+        run: |
+          set -euo pipefail
+          python3 -m py_compile tools/cloud/*.py
+          python3 -m unittest discover -s tools/cloud/tests -v
+          for script in tools/cloud/*.sh; do bash -n "$script"; done
+          git diff --check
+      - name: Install digest-pinned actionlint and validate the two cloud workflows
+        run: |
+          set -euo pipefail
+          curl --disable --fail --location --retry 2 https://github.com/rhysd/actionlint/releases/download/v1.7.7/actionlint_1.7.7_linux_amd64.tar.gz -o "$RUNNER_TEMP/actionlint.tar.gz"
+          printf '023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757  %s\n' "$RUNNER_TEMP/actionlint.tar.gz" | sha256sum -c -
+          tar -xzf "$RUNNER_TEMP/actionlint.tar.gz" -C "$RUNNER_TEMP" actionlint
+          "$RUNNER_TEMP/actionlint" -shellcheck= .github/workflows/cloud-config-check.yml .github/workflows/test-server-deploy.yml
+  install-and-local-transactions:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 35
