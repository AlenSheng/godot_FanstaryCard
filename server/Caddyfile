{
	# Proxy error logs can contain the full upgrade URI, including a one-use ticket.
	# Remove request URI and headers from runtime logs. Access logging stays disabled.
	log default {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
		}
	}
}
(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
}

# Game clients connect to the public domain. TLS terminates here with a
# publicly trusted certificate; the application is reachable only through Caddy.
relicbound.cn, www.relicbound.cn {
	import security_headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@admin path /admin /admin/* /api/admin /api/admin/*
	handle @admin {
		respond 404
	}

	# Keep game API, WebSocket, and health routes on the application while
	# serving the public website as static files at the root domain.
	@game_api path /api/* /ws/* /health/*
	handle @game_api {
		header >Cache-Control "private, no-store"
		request_body {
			max_size 2097152
		}
		# Preserve upstream Content-Type and bytes; do not impose a WebSocket lifetime.
		reverse_proxy server:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}

# Do not expose the player API through the origin IP. Keeping the certificate
# listener returns a uniform response without revealing application metadata.
43.172.70.182 {
	import security_headers
	tls /etc/caddy/certs/ip2.crt /etc/caddy/certs/ip2.key
	respond 404
}

# Serve the separate management console with the public www certificate.
# Restrict TCP 20000 to administrator IPs in the cloud security group; the API
# also requires X-Admin-Key.
www.relicbound.cn:20000 {
	import security_headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@admin path /admin /admin/* /api/admin /api/admin/*
	handle @admin {
		header >Cache-Control "private, no-store"
		request_body {
			max_size 65536
		}
		# Preserve upstream Content-Type and bytes; do not impose a WebSocket lifetime.
		reverse_proxy server:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
	handle {
		respond 404
	}
}
