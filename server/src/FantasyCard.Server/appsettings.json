{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Persistence": {
    "MaxPoolSize": 16,
    "MinPoolSize": 1,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 10,
    "KeepAliveSeconds": 30
  },
  "Identity": {
    "SessionLifetimeDays": 30,
    "EnableLocalAuth": false,
    "AccountDeletionCoolingPeriodDays": 7,
    "RealtimeTicketLifetimeSeconds": 60,
    "Steam": {
      "Enabled": false,
      "AppId": 0,
      "PublisherKey": "",
      "Identity": ""
    },
    "Google": {
      "Enabled": false,
      "WebClientId": "",
      "AllowedAudiences": [],
      "RequireEmailVerified": true
    }
  },
  "RequestLimits": {
    "WindowSeconds": 60,
    "AuthPermitLimit": 10,
    "MarketReadPermitLimit": 120,
    "EconomyWritePermitLimit": 30,
    "RealtimeCommandsPerSecond": 30,
    "RestMaximumBodyBytes": 65536,
    "JsonMaximumDepth": 16
  },
  "ProtobufHttp": {
    "AllowLegacyJson": false
  },
  "Realtime": {
    "AllowLegacyAccessTokenQuery": false,
    "EventStreamIdleRetentionMinutes": 60,
    "CleanupIntervalMinutes": 10
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  }
}
