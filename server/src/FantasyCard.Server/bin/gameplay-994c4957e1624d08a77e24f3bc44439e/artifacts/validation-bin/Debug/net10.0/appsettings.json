{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=fantasycard;Username=fantasycard;Password=fantasycard_dev"
  },
  "Identity": {
    "SessionLifetimeDays": 30,
    "EnableLocalAuth": false
  },
  "RequestLimits": {
    "WindowSeconds": 60,
    "AuthPermitLimit": 10,
    "MarketReadPermitLimit": 120,
    "EconomyWritePermitLimit": 30,
    "RealtimeCommandsPerSecond": 30,
    "RestMaximumBodyBytes": 65536,
    "JsonMaximumDepth": 16
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  }
}
