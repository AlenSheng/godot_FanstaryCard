<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Pr13RuntimeDirectory Condition="'$(Pr13RuntimeDirectory)' == ''">runtime</Pr13RuntimeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FantasyCard.Domain"><HintPath>$(Pr13RuntimeDirectory)/FantasyCard.Domain.dll</HintPath></Reference>
    <Reference Include="FantasyCard.Contracts"><HintPath>$(Pr13RuntimeDirectory)/FantasyCard.Contracts.dll</HintPath></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(Pr13RuntimeDirectory)/Google.Protobuf.dll</HintPath></Reference>
  </ItemGroup>
</Project>
